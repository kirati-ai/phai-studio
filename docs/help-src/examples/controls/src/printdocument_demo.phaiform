# Phai Studio form - docs/phaiform.md
format = 1

[form]
name = "PrintdocumentDemo"
title = "PrintDocument"
size = [360, 130]
start = "center"

[[control]]
kind = "label"
id = "hint"
text = "A certificate, printed or seen first."
bounds = [16, 16, 328, 24]

[[control]]
kind = "button"
id = "preview"
text = "Print preview"
bounds = [16, 52, 150, 30]
class = "primary"
on_click = "preview_clicked"

[[control]]
kind = "button"
id = "print"
text = "Print..."
bounds = [178, 52, 150, 30]
on_click = "print_clicked"

[[control]]
kind = "printdocument"
id = "certificate"
document_name = "Certificate"
landscape = true

[control.events]
print_page = "certificate_print_page"
