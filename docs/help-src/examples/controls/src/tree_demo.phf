# Phai Studio form - docs/phaiform.md
format = 1

[form]
name = "TreeDemo"
title = "TreeView"
size = [360, 260]
start = "center"

[[control]]
kind = "tree"
id = "zoo"
bounds = [16, 16, 200, 200]
on_select = "zoo_chosen"

[[control]]
kind = "label"
id = "chosen"
text = "Choose an animal"
bounds = [226, 16, 120, 60]
