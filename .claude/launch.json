{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "help",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/help"
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "D:/DesktopServer/php82/php.exe",
      "runtimeArgs": [
        "-S",
        "localhost:8790",
        "-t",
        "target/site",
        "site/router.php"
      ],
      "port": 8790
    }
  ]
}
