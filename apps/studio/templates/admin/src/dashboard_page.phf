# Phai Studio form - docs/phaiform.md
format = 1

[form]
name = "DashboardPage"
title = "Dashboard"
size = [990, 675]
font_size = 10
user_control = true

[[control]]
kind = "label"
id = "welcome"
text = "Welcome back, Somchai"
bounds = [24, 20, 600, 30]
class = "heading"

[[control]]
kind = "label"
id = "welcome_note"
text = "Here is how the shop is doing today."
bounds = [24, 50, 600, 22]
class = "muted"

[[control]]
kind = "panel"
id = "sales_card"
bounds = [24, 88, 222, 112]
back_color = "#ffffff"

[[control]]
kind = "panel"
id = "sales_strip"
bounds = [24, 88, 5, 112]
back_color = "#12855f"

