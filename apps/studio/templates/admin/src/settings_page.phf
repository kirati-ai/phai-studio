# Phai Studio form - docs/phaiform.md
format = 1

[form]
name = "SettingsPage"
title = "Settings"
size = [990, 675]
font_size = 10
user_control = true

[[control]]
kind = "label"
id = "heading"
text = "Settings"
bounds = [24, 20, 500, 30]
class = "heading"

[[control]]
kind = "label"
id = "note"
text = "How the back office works for your shop."
bounds = [24, 50, 500, 22]
class = "muted"

[[control]]
kind = "label"
id = "shop_label"
text = "Shop name"
bounds = [24, 92, 240, 20]
class = "muted"

[[control]]
kind = "edit"
id = "shop"
text = "Phai Admin"
bounds = [24, 114, 520, 30]

[[control]]
kind = "label"
id = "email_label"
text = "Send order emails to"
bounds = [24, 160, 240, 20]
class = "muted"

[[control]]
kind = "edit"
id = "email"
text = "orders@example.com"
bounds = [24, 182, 520, 30]

[[control]]
kind = "label"
id = "currency_label"
text = "Currency"
bounds = [24, 228, 240, 20]
class = "muted"

[[control]]
kind = "combo"
id = "currency"
bounds = [24, 250, 250, 30]
items = ["Thai baht (฿)", "US dollar ($)", "Euro (€)"]

[[control]]
kind = "label"
id = "low_label"
text = "Low stock below"
bounds = [294, 228, 250, 20]
class = "muted"

[[control]]
kind = "number"
id = "low_stock"
bounds = [294, 250, 120, 30]
min = 1
max = 1000
value = 10

[[control]]
kind = "checkbox"
id = "daily_email"
text = "Email me a summary every morning"
bounds = [24, 302, 400, 24]
checked = true

[[control]]
kind = "checkbox"
id = "new_order_sound"
text = "Play a sound for each new order"
bounds = [24, 332, 400, 24]

[[control]]
kind = "button"
id = "save"
text = "Save changes"
bounds = [24, 382, 140, 34]
class = "primary"
on_click = "save_clicked"

[[control]]
kind = "label"
id = "saved"
text = ""
bounds = [180, 388, 360, 22]
class = "up"
